        {
          "@type": "OfferCatalog",
          "name": "Included with every stay",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Dedicated concierge",
                "description": "One point of contact from booking to checkout, on WhatsApp whenever you need them."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Private airport transfers",
                "description": "Pick-up and drop-off at Liberia International (LIR), about an hour away, in air-conditioned vehicles with bilingual drivers."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Daily housekeeping",
                "description": "The villa is refreshed every morning by our housekeeping team, so the beds are made, the bathrooms refreshed and the kitchen is clean."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Two chef breakfasts",
                "description": "Our private chef cooks breakfast for the whole group on two mornings of your stay. You pay only for the food."
              }
            }
          ]
        },
        {
          "@type": "OfferCatalog",
          "name": "Arranged on request",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Private chef",
                "description": "Beyond the included breakfasts, our chef cooks lunches and dinners in your kitchen with fresh local ingredients: Costa Rican classics, or a menu built around your group. You choose the dishes."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Spa & massage",
                "description": "Massages and treatments with professional therapists who come to you: by the pool, on the rooftop, or in your room."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Grocery stocking",
                "description": "Arrive to a full fridge. Send your list ahead and everything is put away before you land."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Golf carts & cars",
                "description": "Golf carts (4 or 6 passenger) are how Flamingo gets around, and they are welcome on all the local roads. For longer days out, rental cars in all different sizes are a message away."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Fishing charters",
                "description": "Sport fishing out of Marina Flamingo, a few minutes from the villa. Full and half-day charters for marlin, sailfish, mahi-mahi, tuna and roosterfish, year-round. Bring dinner back to the kitchen."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Catamaran tours",
                "description": "Sunset sails, snorkelling stops and private catamaran charters along the Guanacaste coast. Drinks, snacks and snorkelling gear are on board."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Surf lessons",
                "description": "Lessons for first-timers through to advanced surfers at the nearby breaks. Boards, rash guards and coaching are provided, and the water is warm enough to skip the wetsuit."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Jet skis",
                "description": "Rentals at the nearby beaches, with guided rides along the coast if you want someone who knows the coves."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Ziplining",
                "description": "Zipline courses through the forest canopy, with guides and gear taken care of. The quickest way to meet the trees, and the monkeys in them."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Horseback riding",
                "description": "The beach at sunset, or hill trails with the ocean below. Guided rides for every level, first-timers included."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "ATV tours",
                "description": "Off-road through the backcountry, river crossings and hill trails, with guides, machines and safety gear included."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Day trips",
                "description": "The volcano and hot springs at Rincón de la Vieja, a river safari through Palo Verde, or the waterfall at Llanos de Cortés. Leave after breakfast and be back for sunset, with the guide and the transport arranged."
              }
            }
          ]
        }
